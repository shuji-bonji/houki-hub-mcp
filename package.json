{
  "name": "@shuji-bonji/houki-egov-mcp",
  "version": "0.5.2",
  "description": "MCP server for Japanese laws and regulations — e-Gov 法令API v2 client. Part of the houki-hub MCP family.",
  "keywords": [
    "mcp",
    "japan",
    "law",
    "houki",
    "e-gov",
    "legal",
    "regulation",
    "tax",
    "labor",
    "accounting"
  ],
  "author": "shuji-bonji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuji-bonji/houki-egov-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "houki-egov-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "prepublishOnly": "npm run build",
    "check": "biome check --write src"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@shuji-bonji/houki-abbreviations": "^0.4.1",
    "better-sqlite3": "^12.9.0",
    "fast-xml-parser": "^4.5.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/unzipper": "^0.10.10",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
